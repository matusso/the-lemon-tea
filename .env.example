# Copy to .env and fill in. Never commit .env.
# Generate secrets with: openssl rand -base64 48

# Database (docker compose)
DB_OWNER_PASSWORD=
APP_DB_PASSWORD=
DB_PORT=5432

# Application
PUBLIC_URL=http://localhost:8787
PORT=8787
APP_JWT_SECRET=
# 32-byte base64url key encrypting users' provider account tokens (required to connect a
# Formula 1 account). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_ENCRYPTION_KEY=
# Comma-separated extra origins allowed to call the API (e.g. the Vite dev server)
ALLOWED_ORIGINS=http://localhost:5173
# Anonymous visitors may read data from sources whose terms allow public display
ALLOW_ANONYMOUS=true
# Extra source ids anonymous users may read (operator decision; verify provider terms first)
PUBLIC_SOURCES=

# First administrator, created on first start if no users exist
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: OpenF1 authenticated (live) tier. Server-side only.
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Local development outside Docker
DATABASE_URL=postgres://lemontea_app:CHANGE_ME@localhost:5432/lemontea
MIGRATION_DATABASE_URL=postgres://lemontea_owner:CHANGE_ME@localhost:5432/lemontea
